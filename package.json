{
  "name": "ready-player-one",
  "version": "0.4.2-beta.1",
  "description": "头号玩家 · 本地优先的 Agent Session Share 工作台",
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "Ready Player One contributors",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build:dictation && npm run build && electron .",
    "desktop": "npm run build:dictation && electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "npm run build:dictation && npm run build && electron-builder --mac dir",
    "hub": "node core/standalone.mjs",
    "distribute": "npm run build:dictation && npm run build && electron-builder --mac zip --arm64 --x64",
    "distribute:windows": "npm run build && electron-builder --win zip nsis --x64",
    "postinstall": "node scripts/prepare-native.mjs",
    "build:dictation": "node desktop/services/build-dictation.mjs",
    "distribute:linux": "node scripts/distribute-linux.mjs",
    "release:manifest": "node scripts/release-manifest.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@uiw/react-codemirror": "^4.23.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0",
    "typescript": "^5.8.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.9",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.readyplayerone.desktop",
    "productName": "头号玩家",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "core/**",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "identity": null,
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "release/native/rpo-dictation",
          "to": "rpo-dictation"
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "按下语音按钮后录制你的口述内容。",
        "NSSpeechRecognitionUsageDescription": "将你主动录制的语音转为输入框中的文字。"
      },
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "artifactName": "Ready-Player-One-${version}-mac-${arch}.${ext}",
    "win": {
      "target": [
        "zip",
        "nsis"
      ],
      "artifactName": "Ready-Player-One-${version}-windows-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Ready-Player-One-${version}-windows-${arch}-setup.${ext}",
      "createDesktopShortcut": true
    },
    "toolsets": {
      "nsis": "1.2.1"
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage",
        "zip"
      ],
      "category": "Development",
      "artifactName": "Ready-Player-One-${version}-linux-${arch}.${ext}",
      "icon": "assets/icon.png"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
